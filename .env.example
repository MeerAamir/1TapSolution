# -----------------------------------------------------------------------------
# 1 TAP SOLUTION — environment variables
# Copy to .env.local for local development. Never commit real values.
# -----------------------------------------------------------------------------

# ---- Public build-time values (VITE_*) -------------------------------------
# These are bundled into the website and visible to anyone. Never put secrets here.

# Supabase project URL and the PUBLIC anon key (Project Settings → API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Canonical public address of the site, without a trailing slash.
# Every QR code encodes ${VITE_PUBLIC_APP_URL}/q/<code>. Set it to the FINAL
# domain before printing codes. Changing it later breaks printed codes.
VITE_PUBLIC_APP_URL=https://your-domain.example

# Optional public contact details shown on the website (leave empty to hide).
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=

# Optional tuning.
VITE_DEMO_QR_CODE=demoCafe01
# Keep in line with the storage bucket limit (supabase/migrations/..._storage.sql).
VITE_MAX_UPLOAD_MB=10
# Time zone for analytics charts. Defaults to the viewer's browser time zone.
VITE_ANALYTICS_TIMEZONE=
# "on" to load files from this site's /f/ path through Cloudflare's cache
# (set FILE_PROXY=on for the edge too). See docs/FREE_HOSTING.md.
VITE_FILE_PROXY=

# ---- Server-only values (Cloudflare Pages → Settings → Variables) ----------
# Set these in the Cloudflare dashboard as encrypted variables. They are read by
# the edge functions in /functions and never reach the browser.
#
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# EDGE_INGEST_SECRET=at-least-32-random-characters   (also registered in the database, see docs/DEPLOYMENT.md)
# VISITOR_HASH_SECRET=another-32-plus-random-characters   (optional)
# FILE_PROXY=on                                           (optional, with VITE_FILE_PROXY=on)
#
# The Supabase service-role key is NOT used by the website or the edge
# functions. Only the one-off demo seeding script needs it, run from your own
# terminal (see scripts/seed-demo-files.mjs).
